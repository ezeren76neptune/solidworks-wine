#!/bin/bash
# Run a command in the SOLIDWORKS Wine prefix, with the fixes SOLIDWORKS needs.
#
#   sw-wine wine 'C:\users\Public\Desktop\SOLIDWORKS Design.lnk'   start SOLIDWORKS
#   sw-wine wine foo.exe | sw-wine winetricks ... | sw-wine wineserver -k
#
# Everything runs inside bubblewrap (bwrap) so the fixes apply to this process
# tree only; the system's Wine files are never modified:
#   * /dev/ntsync is hidden (Wine's in-process sync asserts under .NET load);
#   * a hosts file that resolves Wine's 15-character computer name;
#   * patched copies of ntdll.dll, wininet.dll (64- and 32-bit), shell32.dll, uxtheme.dll,
#     comctl32_v6.dll, win32u.so, winex11.so and wineserver are bound over the system
#     files (see docs/FIXES.md). Each copy is
#     keyed by the hash of the system file, so a Wine update regenerates it;
#   * Open/Save dialogs use the desktop's (KDE) file dialog, see SW_FILEDLG.
#
# Environment:
#   WINEPREFIX   prefix to use (default: <repo>/prefix)
#   SW_GPU       nvidia = 3D view on an NVIDIA GPU via PRIME render offload (hybrid laptops);
#                default: the system's default (integrated) GPU
#   SW_FILEDLG   wine = Wine's own Open/Save dialogs instead of KDE's (kdialog)
#   SW_WINE_PE   Wine's x86_64-windows directory, if it is not found automatically
#   SW_WV2_EXTRA extra WebView2 browser arguments, e.g. --remote-debugging-port=9222 to drive the
#                Installation Manager's pages (docs/INSTALL-STANDALONE.md). Every sw-wine command
#                run while a WebView2 program is open must pass the same value
SW_ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
TOOLS="$SW_ROOT/tools"
BUILD="$TOOLS/build"
mkdir -p "$BUILD"

export WINEPREFIX="${WINEPREFIX:-$SW_ROOT/prefix}"
export WINEARCH=win64
export WINEDEBUG="${WINEDEBUG:--all}"

# SW_GPU=nvidia puts OpenGL (the 3D view) on the NVIDIA GPU. SOLIDWORKS presents its
# viewports with glFlush on the front buffer, which PRIME offload never shows, so this mode
# also needs the win32u changes further down.
# Direct3D (DXVK, used by the embedded web panels) stays on the integrated GPU: with it on
# NVIDIA too, opening a part hung.
SW_GPU="${SW_GPU:-}"
if [ "$SW_GPU" = nvidia ]; then
    export __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia
    if [ -z "${DXVK_FILTER_DEVICE_NAME:-}" ]; then
        for v in /sys/class/drm/card*/device/vendor; do
            case $(cat "$v" 2>/dev/null) in
                0x8086) export DXVK_FILTER_DEVICE_NAME=Intel; break ;;
                0x1002) export DXVK_FILTER_DEVICE_NAME=AMD; break ;;
            esac
        done
    fi
fi
# The WebView2 sign-in page: its GPU process needs composition swap chains that
# Wine lacks (it crashed three times before falling back), and its sandbox does not
# work under Wine. Dassault's WebView2Loader.dll (2021) ignores the
# WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS variable, so these go in as a registry policy
# further down.
WV2_ARGS="--no-sandbox --disable-gpu --disable-gpu-compositing${SW_WV2_EXTRA:+ $SW_WV2_EXTRA}"

command -v bwrap >/dev/null || { echo "sw-wine: bubblewrap (bwrap) is required" >&2; exit 1; }

# Wine's PE (x86_64-windows) directory: Fedora's WoW64 build, Debian/Ubuntu, Arch, WineHQ packages.
if [ -z "${SW_WINE_PE:-}" ]; then
    for d in /usr/lib64/wine-wow64/wine/x86_64-windows /usr/lib64/wine/x86_64-windows \
             /usr/lib/x86_64-linux-gnu/wine/x86_64-windows /usr/lib/wine/x86_64-windows \
             /opt/wine-staging/lib/wine/x86_64-windows /opt/wine-devel/lib/wine/x86_64-windows \
             /opt/wine-stable/lib/wine/x86_64-windows; do
        [ -e "$d/ntdll.dll" ] && { SW_WINE_PE=$d; break; }
    done
fi
WINE_PE="${SW_WINE_PE:-}"
[ -e "$WINE_PE/ntdll.dll" ] || { echo "sw-wine: set SW_WINE_PE to Wine's x86_64-windows directory" >&2; exit 1; }
WINE_UNIX="$(dirname "$WINE_PE")/x86_64-unix"

# Hide /dev/ntsync: wineserver then falls back to server-side synchronisation.
NOSYNC="$BUILD/.no-ntsync"
[ -e "$NOSYNC" ] || { : > "$NOSYNC"; chmod 000 "$NOSYNC"; }
BINDS=()
[ -e /dev/ntsync ] && BINDS+=(--bind "$NOSYNC" /dev/ntsync)

# Wine's computer name is the hostname cut to 15 characters. SOLIDWORKS resolves
# it at startup and stalls ("Loading registry...") on DNS timeouts when Linux
# does not know that name.
HOSTS="$BUILD/.hosts"
{ cat /etc/hosts; echo "127.0.0.1 $(hostname -s | cut -c1-15)"; } > "$HOSTS.$$" && mv "$HOSTS.$$" "$HOSTS"
BINDS+=(--ro-bind "$HOSTS" /etc/hosts)

hash16() { cat "$@" | sha256sum | cut -c1-16; }

# ntdll (required) and wininet: functions Dassault's runtime needs that Wine
# lacks, injected from the blobs tools/build.sh compiles.
for b in ntdll_add wininet_add shell32_add uxtheme_add; do
    [ -e "$BUILD/$b.bin" ] || { echo "sw-wine: run tools/build.sh first" >&2; exit 1; }
done
patch_dll() { # dll blob pe-inject-args...   (PATCH_POST=<tools script> IN OUT: applied afterwards)
    local dll=$1 blob=$2 sys="$WINE_PE/$1" out post="${PATCH_POST:-}"
    out="$BUILD/${dll%.dll}-$(hash16 "$sys" "$BUILD/$blob.bin" ${post:+"$TOOLS/$post"}).dll"
    if [ ! -e "$out" ]; then
        python3 -I "$TOOLS/pe-inject.py" "$sys" "$out.tmp" "$BUILD/$blob.bin" \
            "$BUILD/$blob.syms" "${@:3}" >&2 || exit 1
        # a post patch that does not fit this Wine build leaves the pe-inject result
        if [ -z "$post" ] || ! python3 -I "$TOOLS/$post" "$out.tmp" "$out" >&2; then
            mv "$out.tmp" "$out"
        fi
        rm -f "$out.tmp"
    fi
    BINDS+=(--ro-bind "$out" "$sys")
}
patch_dll ntdll.dll ntdll_add --export RtlIsNameInExpression \
    --export LdrpHandleTlsData=LdrpHandleTlsData_impl --export LdrpReleaseTlsEntry=LdrpReleaseTlsEntry_impl --ldrp-tls
# wininet: InternetSetCookieEx2 (sign-in cookie handoff), and no password box for a 401
# that offers no scheme WinINet can answer (expired sign-in, tools/wininet_errordlg.c).
# Also: InternetSetFilePointer back to the start before the first read threw away a reply sent
# with "Cache-Control: no-store" (Wine re-reads from its cache file, which then does not exist),
# so the SOLIDWORKS Installation Manager got empty replies: "Could not connect to the SOLIDWORKS
# server" (tools/patch-wininet-seek.py).
PATCH_POST=patch-wininet-seek.py patch_dll wininet.dll wininet_add --export InternetSetCookieEx2 --replace InternetErrorDlg=InternetErrorDlg_wrap
# The Installation Manager (sldIM.exe) is 32-bit, so the same fix goes into the i386 wininet.dll.
NET32="$(dirname "$WINE_PE")/i386-windows/wininet.dll"
if [ -e "$NET32" ]; then
    NET32_FIXED="$BUILD/wininet32-$(hash16 "$NET32" "$TOOLS/patch-wininet-seek.py").dll"
    [ -e "$NET32_FIXED" ] || python3 -I "$TOOLS/patch-wininet-seek.py" "$NET32" "$NET32_FIXED" >&2 || true
    [ -e "$NET32_FIXED" ] && BINDS+=(--ro-bind "$NET32_FIXED" "$NET32")
fi
# shell32: SOLIDWORKS' "Show in Folder" calls SHOpenFolderAndSelectItems, which in Wine only works
# with Wine's own explorer; show the file in the Linux file manager instead (tools/shell32_openfolder.c).
patch_dll shell32.dll shell32_add --replace SHOpenFolderAndSelectItems=SHOpenFolderAndSelectItems_wrap
# uxtheme: themed check boxes and buttons hand their own paint DC to the parent through
# DrawThemeParentBackground; SOLIDWORKS' PropertyManager pages ReleaseDC() it, and Wine then disabled
# it, so "Draft outward" and the Direction 2 check box stayed blank. The parent now paints into a
# private memory DC, as with Windows' buffered painting (tools/uxtheme_parentbg.c).
patch_dll uxtheme.dll uxtheme_add --replace DrawThemeParentBackground=DrawThemeParentBackground_wrap

# comctl32 v6: the header control crashes on HDM_LAYOUT with a NULL layout, which
# a SOLIDWORKS task pane sends at startup, and themed toolbars left unpainted slots
# black (the S-key shortcut bar). The prefix keeps its own copy in winsxs
# and that copy is the one Wine maps, so bind the fixed file over both.
CC6="$WINE_PE/comctl32_v6.dll"
if [ -e "$CC6" ]; then
    CC6_FIXED="$BUILD/comctl32_v6-$(cat "$CC6" "$TOOLS/patch-comctl32.py" | sha256sum | cut -c1-16).dll"
    [ -e "$CC6_FIXED" ] || python3 -I "$TOOLS/patch-comctl32.py" "$CC6" "$CC6_FIXED" >&2
    if [ -e "$CC6_FIXED" ]; then
        BINDS+=(--ro-bind "$CC6_FIXED" "$CC6")
        for f in "$WINEPREFIX"/drive_c/windows/winsxs/amd64_microsoft.windows.common-controls_*/comctl32.dll; do
            [ -e "$f" ] && cmp -s "$f" "$CC6" && BINDS+=(--ro-bind "$CC6_FIXED" "$f")
        done
    fi
fi

# win32u: Wine re-sends WM_CAPTURECHANGED to a window that keeps the mouse
# capture, which swallows clicks on PropertyManager buttons (Wine bug 27403), and
# its mouse-leave tracking ignored captures, so a toolbar tooltip could stay up.
# It also moved child windows given HWND_TOPMOST, which Windows leaves in place:
# PropertyManager group headers slid off the page on every repaint.
W32U="$WINE_UNIX/win32u.so"
W32U_BIND=
if [ -e "$W32U" ]; then
    W32U_FIXED="$BUILD/win32u-$(cat "$W32U" "$TOOLS/patch-win32u.py" | sha256sum | cut -c1-16).so"
    [ -e "$W32U_FIXED" ] || python3 -I "$TOOLS/patch-win32u.py" "$W32U" "$W32U_FIXED" >&2
    [ -e "$W32U_FIXED" ] && W32U_BIND="$W32U_FIXED"
fi

# NVIDIA mode (see SW_GPU above). SOLIDWORKS draws into the front buffer and presents with
# glFlush; it also uses the back buffer as scratch (clears it, draws overlays such as the view
# triad, copies changed strips to the front), so front and back must stay separate buffers.
# Every GL window therefore goes through Wine's framebuffer surfaces: an FBO with separate
# front and back, presented to the window with a real swap (tools/patch-win32u-nvidia.py).
# Saving renders the file's preview into a bitmap; Wine copies that bitmap with a context
# NVIDIA's GLX rejects, which ended SOLIDWORKS mid-save (tools/patch-win32u-memdc.py).
# SOLIDWORKS' NVIDIA-only GL_KTX_buffer_region save/restore misses the FBO and leaves trails
# behind drag previews, so it is hidden from sldworks.exe; SOLIDWORKS then redraws instead,
# as it does on Mesa. That setting stays in the prefix and changes nothing on other drivers.
if [ "$SW_GPU" = nvidia ]; then
    W32U_NV="$BUILD/win32u-nvidia-$(cat "$W32U" "$TOOLS/patch-win32u.py" "$TOOLS/patch-win32u-nvidia.py" "$TOOLS/patch-win32u-memdc.py" 2>/dev/null | sha256sum | cut -c1-16).so"
    if [ ! -e "$W32U_NV" ] && [ -n "$W32U_BIND" ]; then
        python3 -I "$TOOLS/patch-win32u-nvidia.py" "$W32U_BIND" "$W32U_NV.fb" >&2 &&
            python3 -I "$TOOLS/patch-win32u-memdc.py" "$W32U_NV.fb" "$W32U_NV" >&2
        rm -f "$W32U_NV.fb"
    fi
    if [ -e "$W32U_NV" ]; then
        W32U_BIND="$W32U_NV"
        if [ "${1:-}" = wine ] && [ -z "${SW_NV_REG:-}" ] && [ -e "$WINEPREFIX/user.reg" ] &&
                ! grep -qF '"DisabledExtensions"="GL_KTX_buffer_region"' "$WINEPREFIX/user.reg"; then
            SW_FOLDER_SYNCING=1 SW_NV_REG=1 SW_PLACES_SYNCING=1 SW_FILEDLG_SYNCING=1 "$0" wine reg add \
                'HKCU\Software\Wine\AppDefaults\sldworks.exe\OpenGL' /v DisabledExtensions /d GL_KTX_buffer_region /f >/dev/null
        fi
    else
        # Without the patches the 3D view never updates on NVIDIA (and a session like that
        # wedged once). Fall back to the integrated GPU rather than start a broken session.
        MSG="NVIDIA mode needs a patch that does not fit this Wine build; starting on the integrated GPU instead."
        echo "sw-wine: $MSG" >&2
        [ "${1:-}" = wine ] && command -v notify-send >/dev/null &&
            notify-send -a SOLIDWORKS "SOLIDWORKS: NVIDIA mode unavailable" "$MSG" 2>/dev/null
        unset __NV_PRIME_RENDER_OFFLOAD __GLX_VENDOR_LIBRARY_NAME DXVK_FILTER_DEVICE_NAME
        SW_GPU=
    fi
fi
[ -n "$W32U_BIND" ] && BINDS+=(--ro-bind "$W32U_BIND" "$W32U")

# wineserver: the sign-in page is drawn by msedgewebview2.exe into a child of the
# launcher's window. A process cannot use another process's window surface, so Wine
# draws such a child straight onto the X11 window, and the launcher's next surface
# flush painted its own (white) copy back over the page: it went white a few seconds
# after each redraw and the text cursor never showed. wineserver now keeps the parent's
# surface off children owned by another process, as it does for OpenGL children
# (tools/patch-wineserver.py).
WSRV="$(readlink -f "$(command -v wineserver)" 2>/dev/null)"
if [ -n "$WSRV" ] && [ -e "$WSRV" ]; then
    WSRV_FIXED="$BUILD/wineserver-$(cat "$WSRV" "$TOOLS/patch-wineserver.py" | sha256sum | cut -c1-16)"
    [ -e "$WSRV_FIXED" ] || { python3 -I "$TOOLS/patch-wineserver.py" "$WSRV" "$WSRV_FIXED" >&2 && chmod +x "$WSRV_FIXED"; }
    [ -x "$WSRV_FIXED" ] && BINDS+=(--ro-bind "$WSRV_FIXED" "$WSRV")
fi

# winex11: keep the keyboard focus where SOLIDWORKS puts it. Typing in a PropertyManager
# number box makes SOLIDWORKS show small popups (a tooltip, a "Filter Quick Hits" suggestion
# list); the window manager offered them the focus and Wine accepted, so the box lost the
# focus after one character (tools/patch-winex11-focus.py).
X11="$WINE_UNIX/winex11.so"
if [ -e "$X11" ]; then
    X11_FIXED="$BUILD/winex11-focus-$(cat "$X11" "$TOOLS/patch-winex11-focus.py" | sha256sum | cut -c1-16).so"
    [ -e "$X11_FIXED" ] || python3 -I "$TOOLS/patch-winex11-focus.py" "$X11" "$X11_FIXED" >&2
    [ -e "$X11_FIXED" ] && BINDS+=(--ro-bind "$X11_FIXED" "$X11")
fi

# Open/Save/Export dialogs: the desktop's own file dialog (kdialog, KDE's file picker as used
# by Dolphin) instead of Wine's. tools/swfiledlg.dll (built by tools/build-pe.sh) serves
# CLSID_FileOpenDialog and CLSID_FileSaveDialog, wraps Wine's dialog and only replaces Show().
# It is registered over comdlg32 in HKLM (Wine's COM has no per-user classes) and re-checked
# on each start, since a Wine update re-registers comdlg32. SW_FILEDLG=wine, or no kdialog
# on the system, puts Wine's dialog back.
if [ "${1:-}" = wine ] && [ -z "${SW_FILEDLG_SYNCING:-}" ] && [ -e "$BUILD/swfiledlg.dll" ] \
        && [ -e "$WINEPREFIX/system.reg" ]; then
    FD_WANT=swfiledlg.dll
    { [ "${SW_FILEDLG:-kde}" = wine ] || ! command -v kdialog >/dev/null; } && FD_WANT=comdlg32.dll
    if [ "$FD_WANT" = swfiledlg.dll ]; then
        FD_DLL="$WINEPREFIX/drive_c/windows/system32/swfiledlg.dll"
        cmp -s "$BUILD/swfiledlg.dll" "$FD_DLL" || cp "$BUILD/swfiledlg.dll" "$FD_DLL"
    fi
    for c in DC1C5A9C-E88A-4DDE-A5A1-60F82A20AEF7 C0B4E2F3-BA21-4773-8DBA-335EC946EB8B; do
        grep -i -A3 -F "[Software\\\\Classes\\\\CLSID\\\\{$c}\\\\InprocServer32]" "$WINEPREFIX/system.reg" | grep -qi "$FD_WANT" ||
            SW_FOLDER_SYNCING=1 SW_FILEDLG_SYNCING=1 SW_PLACES_SYNCING=1 SW_NV_REG=1 "$0" wine reg add \
                "HKLM\\Software\\Classes\\CLSID\\{$c}\\InprocServer32" /ve /d "C:\\windows\\system32\\$FD_WANT" /f >/dev/null 2>&1
    done
fi

# Folders SOLIDWORKS hands to the Windows shell ("open"/"explore", e.g. showing where a file
# is) open in Dolphin ($SW_FILE_MANAGER, else xdg-open) instead of Wine's file browser:
# tools/swopenfolder.exe becomes the Folder class's open and explore command, and Wine's DDE
# route to its own explorer (folder\shell\open\ddeexec) is removed.
if [ "${1:-}" = wine ] && [ -z "${SW_FOLDER_SYNCING:-}" ] && [ -e "$BUILD/swopenfolder.exe" ] \
        && [ -e "$WINEPREFIX/system.reg" ]; then
    OF_EXE="$WINEPREFIX/drive_c/windows/system32/swopenfolder.exe"
    cmp -s "$BUILD/swopenfolder.exe" "$OF_EXE" || cp "$BUILD/swopenfolder.exe" "$OF_EXE"
    if ! grep -A3 -F '[Software\\Classes\\folder\\shell\\explore\\command]' "$WINEPREFIX/system.reg" | grep -q swopenfolder ||
            grep -qF '[Software\\Classes\\folder\\shell\\open\\ddeexec]' "$WINEPREFIX/system.reg"; then
        for v in open explore; do
            SW_FOLDER_SYNCING=1 SW_WV2_SYNCING=1 SW_FILEDLG_SYNCING=1 SW_PLACES_SYNCING=1 SW_NV_REG=1 "$0" wine reg add \
                "HKLM\\Software\\Classes\\folder\\shell\\$v\\command" /ve /d '"C:\windows\system32\swopenfolder.exe" "%1"' /f >/dev/null 2>&1
        done
        SW_FOLDER_SYNCING=1 SW_WV2_SYNCING=1 SW_FILEDLG_SYNCING=1 SW_PLACES_SYNCING=1 SW_NV_REG=1 "$0" wine reg delete \
            'HKLM\Software\Classes\folder\shell\open\ddeexec' /f >/dev/null 2>&1
    fi
fi
# WebView2 browser arguments (WV2_ARGS above). This runtime takes the
# AdditionalBrowserArguments policy only from HKLM with the value name "*".
if [ "${1:-}" = wine ] && [ -z "${SW_WV2_SYNCING:-}" ] && [ -e "$WINEPREFIX/system.reg" ] &&
        ! grep -qF "\"*\"=\"$WV2_ARGS\"" "$WINEPREFIX/system.reg"; then
    SW_WV2_SYNCING=1 SW_FOLDER_SYNCING=1 SW_FILEDLG_SYNCING=1 SW_PLACES_SYNCING=1 SW_NV_REG=1 "$0" wine reg add \
        'HKLM\Software\Policies\Microsoft\Edge\WebView2\AdditionalBrowserArguments' \
        /v '*' /d "$WV2_ARGS" /f >/dev/null 2>&1
fi

# The core fonts winetricks installs (1998-2000 Arial, Verdana, Times, ...) ask for no
# anti-aliasing at ordinary text sizes, and WebView2 drew the sign-in page's text jagged
# and unevenly spaced. tools/fix-font-gasp.py lets them be smoothed at every size, like
# the versions in current Windows; re-run when the script changes.
FONTS="$WINEPREFIX/drive_c/windows/Fonts"
if [ "${1:-}" = wine ] && [ -d "$FONTS" ]; then
    FSTAMP=$(sha256sum < "$TOOLS/fix-font-gasp.py" | cut -c1-16)
    if [ "$(cat "$WINEPREFIX/.sw-fonts" 2>/dev/null)" != "$FSTAMP" ]; then
        COREFONTS=$(cd "$FONTS" && ls andalemo.ttf arial*.ttf ariblk.ttf comic*.ttf cour*.ttf georgia*.ttf \
                    impact.ttf times*.ttf trebuc*.ttf verdana*.ttf 2>/dev/null)
        [ -z "$COREFONTS" ] || (cd "$FONTS" && python3 -I "$TOOLS/fix-font-gasp.py" $COREFONTS >/dev/null) &&
            echo "$FSTAMP" > "$WINEPREFIX/.sw-fonts"
    fi
fi

# Optional: the file manager's places (Home, Desktop, Documents, Downloads, ...)
# in the left pane of Wine's Open/Save dialogs (tools/build-pe.sh builds the DLL).
# Re-registered when the places, the script or Wine's shell32 change. The import
# goes through this wrapper so the wineserver it starts keeps ntsync hidden.
if [ "${1:-}" = wine ] && [ -z "${SW_PLACES_SYNCING:-}" ] && [ -e "$BUILD/swplaces.dll" ] \
        && [ -d "$WINEPREFIX/drive_c/windows/system32" ]; then
    PLACES_DLL="$WINEPREFIX/drive_c/windows/system32/swplaces.dll"
    cmp -s "$BUILD/swplaces.dll" "$PLACES_DLL" || cp "$BUILD/swplaces.dll" "$PLACES_DLL"
    STAMP=$({ cat "$HOME/.local/share/user-places.xbel" "$HOME/.config/gtk-3.0/bookmarks" \
                  "$HOME/.config/user-dirs.dirs" "$HOME/.config/sw-wine/places" "$TOOLS/sync-places.py" 2>/dev/null
              stat -c %s%Y "$WINE_PE/shell32.dll"; } | sha256sum | cut -c1-16)
    if [ "$(cat "$WINEPREFIX/.sw-places" 2>/dev/null)" != "$STAMP" ]; then
        REG="$BUILD/places.reg"
        python3 -I "$TOOLS/sync-places.py" "$REG" >/dev/null &&
            SW_FOLDER_SYNCING=1 SW_PLACES_SYNCING=1 "$0" wine regedit /S "Z:${REG//\//\\}" &&
            echo "$STAMP" > "$WINEPREFIX/.sw-places"
    fi
fi

exec bwrap --dev-bind / / "${BINDS[@]}" -- "$@"
